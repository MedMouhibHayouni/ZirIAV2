# =============================================================================
# ZirIA Backend - Configuration d'Environnement
# Copiez ce fichier en .env et remplissez les valeurs manquantes
# =============================================================================

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ziria_db

# --- Authentification JWT ---
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# --- Application ---
APP_PORT=3000
NODE_ENV=development

# --- Cloudinary Free Tier (https://cloudinary.com/users/register/free) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase Admin SDK (https://console.firebase.google.com/) ---
# Créez un projet Firebase, allez dans Paramètres > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANT : La clé privée doit être entre guillemets pour préserver les \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Gemini API (https://aistudio.google.com/) ---
GOOGLE_GEMINI_API_KEY=

# --- Microservice Python IA (PyTorch + FastAPI) ---
# Lance le serveur Python séparément : uvicorn main:app --port 8000
AI_SERVICE_URL=http://localhost:8000

# --- Open-Meteo API (Gratuit, aucune clé requise) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Kasserine (coordonnées GPS du centre-ville, défaut pour la météo) ---
KASSERINE_LAT=35.1711
KASSERINE_LNG=8.8306
